{
  "name": "Environment Notifier",
  "version": "2.0",
  "manifest_version": 3,
  "description": "Color-coded transparent banners for various Labflow environments on .com and .ca.",

  "action": {
    "default_title": "Environment Notifier"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.labflow.com/*",
        "*://*.labflow.ca/*",
        "*://*.catalystedu.com/*",
        "*://*.catalyst-edu.ca/*"
      ],
      "js": ["content.js"]
    }
  ],
  "permissions": ["activeTab", "tabs"],
  "host_permissions": [
    "*://*.labflow.com/*",
    "*://*.labflow.ca/*",
    "*://*.catalystedu.com/*",
    "*://*.catalyst-edu.ca/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}